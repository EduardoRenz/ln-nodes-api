# Local development defaults. Do not use these credentials in production.

# Repository backend: IN_MEMORY, POSTGRES, or SQLITE (required).
PERSISTENCE=postgres
# Required for POSTGRES and SQLITE; ignored by IN_MEMORY.
DATABASE_URL=postgres://lightning:lightning@localhost:5432/lightning
# For SQLITE, use a sqlite: URL instead, for example:
# PERSISTENCE=sqlite
# DATABASE_URL=sqlite://lightning.db?mode=rwc

PORT=3000
IMPORT_INTERVAL_SECS=300
MEMPOOL_API_URL=https://mempool.space/api/v1/lightning/nodes/rankings/connectivity
RUST_LOG=info

# Import-run log directory: one append-only file per UTC day (YYYY-MM-DD.log),
# one line per run. Created on first run; ignored by git.
LOG_DIR=log

# Import-run log backend: file (default). Reserved for future backends.
# Only `file` is implemented; other values fail fast at startup.
LOG_BACKEND=file

# Host uid/gid used by compose for the app service, so files written into the
# bind-mounted log/ stay owned by you. Uncomment if your uid/gid is not 1000.
#HOST_UID=1000
#HOST_GID=1000

# Docker Compose host port mappings.
DB_PORT=5432
APP_PORT=3000
