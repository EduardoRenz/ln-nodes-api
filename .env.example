# Local development defaults. Do not use these credentials in production.

# Repository backend: IN_MEMORY, POSTGRES, or SQLITE (required).
PERSISTENCE=postgres
# Required for POSTGRES and SQLITE; ignored by IN_MEMORY.
DATABASE_URL=postgres://lightning:lightning@localhost:5432/lightning
# For SQLITE, use a sqlite: URL instead, for example:
# PERSISTENCE=sqlite
# DATABASE_URL=sqlite://lightning.db?mode=rwc

PORT=3000
IMPORT_INTERVAL_SECS=300
MEMPOOL_API_URL=https://mempool.space/api/v1/lightning/nodes/rankings/connectivity
RUST_LOG=info

# Docker Compose host port mappings.
DB_PORT=5432
APP_PORT=3000
